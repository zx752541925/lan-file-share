# 局域网文件传输（本机开发版，WSL 用户级服务）
#
# 部署位置：~/.config/systemd/user/lanfile.service
# 生效：systemctl --user daemon-reload && systemctl --user restart lanfile
# 日志：journalctl --user -u lanfile -n 50 --no-pager
# 说明：本单元**刻意不 enable** —— 按需求改成"双击启动器才启动"，
#       保持 WSL 启动时不自动拉起服务；相关依赖（deepseek-shim）仍需 enable，
#       否则 agent 的 provider 指向它时会连不上。

[Unit]
Description=局域网文件传输（开发版，含聊天室 Codex）
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xu/projects/局域网文件传输
Environment=HOME=/home/xu
Environment=PATH=/home/xu/npm-global/bin:/home/xu/.local/go/bin:/usr/local/bin:/usr/bin:/bin
# -agent           开启聊天室 Codex（本地版特性，服务器版不需要）
# -open=false      服务器/后台运行时不要自动开浏览器
# -agent-base-url  指向本地 deepseek-shim，让控制台能显示「思考」行
ExecStart=/home/xu/projects/局域网文件传输/bin/lanfile-server -agent -open=false -agent-base-url http://127.0.0.1:41780/
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
